PORT=3000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

JWT_SECRET=
JWT_EXPIRES_IN=12h

# Comma-separated allowed origins (staff portal + online shop). Empty = allow any origin.
CORS_ORIGIN=

SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=

CUSTOMER_RANKING_WINDOW_DAYS=30

CRON_SECRET=
# Online shop payments (PayMongo). Webhook secret = secret_key returned when registering the webhook.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Comma-separated payment_method_types enabled on the PayMongo account.
PAYMONGO_PAYMENT_METHODS=gcash,paymaya
# Public shop URL, no trailing slash (buyers return here after paying).
SHOP_URL=
